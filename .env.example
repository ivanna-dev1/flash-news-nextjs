# Copy this file to .env.local and put your keys there.
# A free Guardian API key: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# Optional: a second key. It is used when the first one hits its daily limit.
GUARDIAN_API_KEY_2=

# PostgreSQL on Neon (https://neon.tech). Neon gives two connection strings.
# Pooled (host has "-pooler"): the app uses it at runtime.
DATABASE_URL=
# Direct (no "-pooler"): Prisma CLI uses it for migrations.
DATABASE_URL_UNPOOLED=

# Better Auth. The secret signs session cookies.
# Make one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# The site address: http://localhost:3000 on your computer.
BETTER_AUTH_URL=
